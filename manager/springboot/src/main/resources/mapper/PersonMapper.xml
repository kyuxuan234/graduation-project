<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.PersonMapper">

    <sql id="Base_Column_List">
        id,username,password,name,phone,email,avatar,role,status,create_time,update_time,deleted
    </sql>

    <select id="selectAll" resultType="com.example.entity.Person">
        select
        <include refid="Base_Column_List" />
        from person
        <where>
            deleted = 0
            <if test="id != null"> and id = #{id}</if>
            <if test="username != null and username != ''"> and username like concat('%', #{username}, '%')</if>
            <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="phone != null and phone != ''"> and phone = #{phone}</if>
            <if test="email != null and email != ''"> and email = #{email}</if>
            <if test="role != null and role != ''"> and role = #{role}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.example.entity.Person">
        select
        <include refid="Base_Column_List" />
        from person
        where id = #{id} and deleted = 0
    </select>

    <select id="selectByUsername" resultType="com.example.entity.Person">
        select
        <include refid="Base_Column_List" />
        from person
        where username = #{username} and deleted = 0
    </select>

    <select id="countActiveAdmins" resultType="int">
        select count(*)
        from person
        where deleted = 0
          and role = 'ADMIN'
          and (status is null or status = 'ACTIVE')
    </select>

    <update id="deleteById">
        update person
        set deleted = 1
        where id = #{id}
    </update>

    <insert id="insert" parameterType="com.example.entity.Person" useGeneratedKeys="true" keyProperty="id">
        insert into person
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
            <if test="name != null">name,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="avatar != null">avatar,</if>
            <if test="role != null">role,</if>
            <if test="status != null">status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="username != null">#{username},</if>
            <if test="password != null">#{password},</if>
            <if test="name != null">#{name},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="role != null">#{role},</if>
            <if test="status != null">#{status},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Person">
        update person
        <set>
            <if test="username != null">
                username = #{username},
            </if>
            <if test="password != null">
                password = #{password},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="email != null">
                email = #{email},
            </if>
            <if test="avatar != null">
                avatar = #{avatar},
            </if>
            <if test="role != null">
                role = #{role},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="selectNotifyMails" resultType="com.example.entity.PersonMailAddress">
        select username, name, email, role
        from person
        where deleted = 0
          and (status is null or status = 'ACTIVE')
          and email is not null
          and trim(email) like '%@%'
    </select>

</mapper>
