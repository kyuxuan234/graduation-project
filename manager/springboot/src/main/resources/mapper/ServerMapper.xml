<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ServerMapper">

    <sql id="Base_Column_List">
        id,hostname,ip,os,cpu,memory,disk,env,status,remark,create_time,update_time,deleted
    </sql>

    <select id="selectAll" resultType="com.example.entity.Server">
        select
        <include refid="Base_Column_List" />,
        (select count(*) from app a where a.server_id = server.id and a.deleted = 0) as app_count
        from server
        <where>
            deleted = 0
            <if test="id != null"> and id= #{id}</if>
            <if test="hostname != null"> and hostname like concat('%', #{hostname}, '%')</if>
            <if test="ip != null"> and ip like concat('%', #{ip}, '%')</if>
            <if test="os != null"> and os like concat('%', #{os}, '%')</if>
            <if test="env != null"> and env= #{env}</if>
            <if test="status != null"> and status= #{status}</if>
        </where>
        order by id desc
    </select>

    <select id="selectNotStopped" resultType="com.example.entity.Server">
        select
        <include refid="Base_Column_List" />
        from server
        where deleted = 0 and status != 'STOPPED'
        order by env, hostname
    </select>

    <select id="selectById" resultType="com.example.entity.Server">
        select
        <include refid="Base_Column_List" />
        from server
        where id = #{id} and deleted = 0
    </select>

    <select id="selectByHostname" resultType="com.example.entity.Server">
        select
        <include refid="Base_Column_List" />
        from server
        where hostname = #{hostname} and deleted = 0
    </select>

    <select id="selectByIp" resultType="com.example.entity.Server">
        select
        <include refid="Base_Column_List" />
        from server
        where ip = #{ip} and deleted = 0
    </select>

    <update id="deleteById">
        update server
        set deleted = 1
        where id = #{id}
    </update>

    <insert id="insert" parameterType="com.example.entity.Server" useGeneratedKeys="true" keyProperty="id">
        insert into server
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="hostname != null">hostname,</if>
                <if test="ip != null">ip,</if>
                <if test="os != null">os,</if>
                <if test="cpu != null">cpu,</if>
                <if test="memory != null">memory,</if>
                <if test="disk != null">disk,</if>
                <if test="env != null">env,</if>
                <if test="status != null">status,</if>
                <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="hostname != null">#{hostname},</if>
                <if test="ip != null">#{ip},</if>
                <if test="os != null">#{os},</if>
                <if test="cpu != null">#{cpu},</if>
                <if test="memory != null">#{memory},</if>
                <if test="disk != null">#{disk},</if>
                <if test="env != null">#{env},</if>
                <if test="status != null">#{status},</if>
                <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.Server">
        update server
        <set>
            <if test="hostname != null">
                hostname = #{hostname},
            </if>
            <if test="ip != null">
                ip = #{ip},
            </if>
            <if test="os != null">
                os = #{os},
            </if>
            <if test="cpu != null">
                cpu = #{cpu},
            </if>
            <if test="memory != null">
                memory = #{memory},
            </if>
            <if test="disk != null">
                disk = #{disk},
            </if>
            <if test="env != null">
                env = #{env},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="remark != null">
                remark = #{remark},
            </if>
        </set>
        where id = #{id}
    </update>

</mapper>
