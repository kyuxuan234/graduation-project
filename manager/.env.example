# 复制为 .env 后填入真实值。密码类字段留空，不要把真实密钥写进这个示例。
# docker compose 读取的是 manager/.env。
# DB_HOST / DB_PORT 只给本地 application-dev.yml。容器里的后端固定连服务名 mysql。
# 生产配置读 DB_URL。compose 会按 mysql:3306 和 DB_NAME 拼好，不用在这里写 DB_URL。
# JWT_SECRET 必须换成随机值。DB_PASSWORD 同时作为容器里 MySQL 的 root 密码。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=manager
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:8080
MAIL_HOST=smtp.yeah.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# SSH 密码和私钥的加密密钥。生产必填，任意非空字符串即可。留空则凭据按明文入库。
CREDENTIAL_KEY=
